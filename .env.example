# [DB 세팅]
MYSQL_DATABASE=news_briefing
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PORT=3306
MYSQL_HOST=localhost

# [SQLAlchemy 연동]
